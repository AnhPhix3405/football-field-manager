    "passport-jwt": "^4.0.1",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1",
    "typeorm": "^0.3.26",
    "bcrypt": "^6.0.0",
    "fastify": "^5.12.1",
    "helmet": "^8.3.0",
